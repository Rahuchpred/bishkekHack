# Copy to .env.local and fill in. Vite only exposes VITE_* vars to the browser.

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# OpenAI key is ONLY used by scripts/generate-art.mjs at build time.
# It is NOT prefixed with VITE_, so it never ships to the browser.
OPENAI_API_KEY=sk-your-openai-key-here
