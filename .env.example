# Copy to .env.local and fill in. Vite only exposes VITE_* vars to the browser.

# Supabase (Project Settings -> API) — must use VITE_ prefix for this Vite app
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" / "public" key (eyJ...) or newer publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# OpenAI key is ONLY used by scripts/generate-art.mjs at build time.
# It is NOT prefixed with VITE_, so it never ships to the browser.
OPENAI_API_KEY=sk-your-openai-key-here

# (Optional) Override the built-in demo TURN relay with your own credentials.
# VITE_TURN_URL=turn:your-host:3478,turns:your-host:5349
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
